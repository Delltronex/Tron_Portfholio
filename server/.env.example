# SMTP Server Environment Configuration

# Server Port (default: 5001)
SERVER_PORT=5001

# SMTP Credentials
# For Gmail: Use App Password from Google Account > Security > 2-Step Verification > App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password_here

# Where the inquiry email will be delivered
SMTP_RECEIVER=your_email@gmail.com
